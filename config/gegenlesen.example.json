{
  "bind": "127.0.0.1",
  "port": 8080,
  "data_dir": "var",
  "models": {
    "model_a": "openrouter/deepseek/deepseek-v4-flash",
    "model_b": "openrouter/google/gemini-3.7-flash"
  },
  "judge_model": "openrouter/openai/gpt-5.6-terra",
  "embeddings": {
    "model": "openai/text-embedding-3-small",
    "dimensions": 1536,
    "max_chunks": 20000,
    "retrieve_k": 12
  },
  "opencode_image": "gegenlesen/opencode-runner:0.1.0",
  "scanner_image": "gegenlesen/scanner:0.1.0",
  "limits": {
    "archive_bytes": 104857600,
    "queued_archive_bytes": 2147483648,
    "agent_timeout_sec": 900,
    "judge_timeout_sec": 300,
    "deterministic_timeout_sec": 30,
    "identify_timeout_sec": 60,
    "rule_token_budget": 6000,
    "scanner_timeout_sec": 120,
    "learn_interval_minutes": 15
  },
  "risk": {
    "mode": "shadow",
    "max_files": 5,
    "max_lines": 200,
    "sensitive_globs": [
      "**/auth/**",
      "**/Auth/**",
      "**/*secret*",
      "**/.env",
      "**/.env.*",
      "**/migrations/**",
      "**/.github/workflows/**",
      "**/Dockerfile",
      "**/Dockerfile.*",
      "**/*.pem",
      "**/*.key",
      "**/payments/**",
      "**/crypto/**",
      "**/compose.yaml",
      "**/compose.yml",
      "**/docker-compose.yaml",
      "**/docker-compose.yml"
    ]
  }
}
