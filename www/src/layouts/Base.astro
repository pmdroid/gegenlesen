---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Two reviewers, house rules, a conservative judge.' } = Astro.props;
const path = Astro.url.pathname;
const docsOn = path.startsWith('/docs');
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.png" type="image/png" />
		<title>{title}</title>
	</head>
	<body>
		<header class="topbar">
			<div class="wrap">
				<a class="brand" href="/">gegenlesen</a>
				<nav>
					<a href="/docs/start" class={docsOn ? 'on' : undefined}>docs</a>
					<a href="https://github.com/pmdroid/gegenlesen">github</a>
				</nav>
				<span class="srv">gegenlesen.dev</span>
			</div>
		</header>
		<slot />
		<footer class="foot">
			<div class="wrap">
				<span>CLI starts the review. Ledger keeps the book.</span>
				<span>no login · bind 127.0.0.1</span>
			</div>
		</footer>
	</body>
</html>
