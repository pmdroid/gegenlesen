---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Two reviewers, house rules, a conservative judge.' } = Astro.props;
const path = Astro.url.pathname;
const docsOn = path.startsWith('/docs');
const site = Astro.site ?? new URL('https://gegenlesen.dev');
const canonical = new URL(path, site).href;
const ogImage = new URL('/og-image.png', site).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<meta name="theme-color" content="#0c0f0a" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="gegenlesen" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="gegenlesen" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<header class="topbar">
			<div class="wrap">
				<a class="brand" href="/">
					<img src="/logo.webp" alt="" />
					gegenlesen
				</a>
				<nav>
					<a href="/docs/start" class={docsOn ? 'on' : undefined}>docs</a>
					<a href="https://github.com/pmdroid/gegenlesen">github</a>
				</nav>
				<span class="srv">gegenlesen.dev</span>
			</div>
		</header>
		<slot />
		<footer class="foot">
			<div class="wrap">
				<span>CLI starts the review. Ledger keeps the book.</span>
				<span>no login · bind 127.0.0.1</span>
			</div>
		</footer>
	</body>
</html>
